{
  "name": "sadnica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:phone": "vite dev --host --mode phone",
    "validate": "vite-node scripts/validate-data.ts",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "splash": "node scripts/make-splash.mjs",
    "prepare": "svelte-kit sync || echo \"\""
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#data/*": "./data/*"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "suncalc": "^1.9.0"
  }
}
