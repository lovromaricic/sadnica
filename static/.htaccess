# Apache rules for the static build. They work in any folder (e.g. /sadnica/) without changes.
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Addresses without .html: /biljke -> biljke.html, /biljke/cesnjak -> biljke/cesnjak.html
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME}.html -f
	RewriteRule ^(.+?)/?$ $1.html [L]

	# Anything else that does not exist gets the app, which shows its own "page not found" screen.
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME}/index.html !-f
	RewriteRule ^ 404.html [L]
</IfModule>

# The service worker must always be fresh, so updates reach people quickly.
<IfModule mod_headers.c>
	<Files "service-worker.js">
		Header set Cache-Control "no-cache"
	</Files>
</IfModule>
